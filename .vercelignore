# Keep internal source / build / report files OFF the public web.
# (These are currently publicly downloadable on GitHub Pages — this fixes that.)
.git
.gitignore
.gitattributes
CNAME
**/.gitkeep
.claude
.DS_Store
__pycache__
node_modules
*.py
*.pyc
_posts
tests
scripts
data
crm
docs
lead-research
property-leads-system
tools/blog-automation
tools/seo-optimizer
office-status.json
schema-realtor.json
# Keep the historical town-photo archive in source control, but deploy only
# the verified photo files and responsive derivatives referenced by public pages.
images/towns/*.webp
images/towns/credits.json
!images/towns/berkeley-heights-1.webp
!images/towns/chatham-borough-1.webp
