# JRG-CRM local configuration. Copy to crm/.env and fill real secrets locally.
NODE_ENV=development
CRM_HOST=127.0.0.1
CRM_PORT=4820
CRM_DATABASE_PATH=./crm.db
CRM_LOG_LEVEL=info
CRM_DASHBOARD_PASSWORD=change-me

# Send gate defaults (Phase 1 seeds these into settings if absent)
CRM_TIMEZONE=America/New_York
CRM_QUIET_HOURS_START=08:30
CRM_QUIET_HOURS_END=20:30
CRM_PER_LEAD_DAILY_CAP=2
CRM_GLOBAL_DAILY_CAP=100
CRM_IMESSAGE_MIN_SECONDS_BETWEEN_SENDS=45
CRM_GLOBAL_PAUSE=false
CRM_AUTONOMY_DEFAULT=approval

# Phase 2: BlueBubbles / iMessage
BLUEBUBBLES_BASE_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=
BLUEBUBBLES_WEBHOOK_SECRET=

# Phase 3: Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4820/oauth/google/callback
GMAIL_REFRESH_TOKEN=
GMAIL_HISTORY_ID=
GMAIL_FROM=jorgeramirez76@gmail.com

# Phase 4: AI
ANTHROPIC_API_KEY=
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_COMPOSER_MODEL=claude-sonnet-5

# Phase 6: site webhook/tracker
CRM_WEBHOOK_SECRET=
CRM_PUBLIC_BASE_URL=

# Phase 7: Higgsfield
HIGGSFIELD_API_KEY=
HIGGSFIELD_VOICE_ID=
HIGGSFIELD_CHARACTER_ID=
